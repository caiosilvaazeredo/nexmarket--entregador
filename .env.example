# Nexmarket Entregador — environment

# Google Maps API key (Android needs it for the in-app map).
# After setting this, also paste it into app.json:
#   android.config.googleMaps.apiKey  and  ios.config.googleMapsApiKey
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# URL do backend de autenticação compartilhado (repo nexmarket--empresa,
# pasta server/) — login/registro não usam mais o Firebase Authentication
# nativo (nem e-mail/senha nativo, nem Google): a senha fica no Firestore e
# este servidor emite o Custom Token de sessão. Em desenvolvimento:
# http://localhost:8787
EXPO_PUBLIC_AUTH_API_URL=""

# The Firebase project is shared with the loja app and lives in
# firebase-config.json (committed on purpose, mirroring the loja repo).
# No Firebase secrets are needed here for client usage.
